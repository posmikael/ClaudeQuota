<Window x:Class="Quota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Quota" Width="400" Height="360" Top="0"
        Topmost="True" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI">
  <!-- Fixed transparent window docked to an edge of the primary display's work area. Only the pill is drawn,
       so everything around it is click-through; the pill animates its size inside the window. -->
  <Window.Resources>
    <Style x:Key="Square" TargetType="Border">
      <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/>
      <Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="1.5"/>
    </Style>
    <Style x:Key="Fill" TargetType="Border">
      <Setter Property="CornerRadius" Value="3"/><Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Height" Value="11"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8E8E93"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <!-- Soap-bubble pill: nearly clear tint, swirling thin-film colours and an iridescent rim -->
  <Border x:Name="Pill" Width="280" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
          Background="#50000000" CornerRadius="0,0,16,16" BorderThickness="1.5,0,1.5,1.5"
          MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" MouseLeftButtonDown="Pill_Down">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="RimSpin" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#B3FF8AD8" Offset="0.2"/>
        <GradientStop Color="#9970E6FF" Offset="0.45"/>
        <GradientStop Color="#99FFF27A" Offset="0.7"/>
        <GradientStop Color="#B3A98BFF" Offset="0.88"/>
        <GradientStop Color="#E6FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Refresh now" Click="Refresh_Click"/>
        <MenuItem Header="Start with Windows" IsCheckable="True" x:Name="StartupItem" Click="Startup_Click"/>
        <Separator/>
        <MenuItem Header="Exit" Click="Exit_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="Inner">
      <Grid.RowDefinitions><RowDefinition x:Name="Row0" Height="36"/><RowDefinition x:Name="Row1" Height="*"/></Grid.RowDefinitions>
      <Grid.Clip><RectangleGeometry x:Name="InnerClip" RadiusX="15" RadiusY="15"/></Grid.Clip>
      <Grid.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.85" Color="Black"/></Grid.Effect>

      <!-- Thin-film colour swirl: strongest at the edge, nearly clear in the middle -->
      <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="FilmSpin" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#55FF7AD0" Offset="0"/>
            <GradientStop Color="#4460DDFF" Offset="0.3"/>
            <GradientStop Color="#44FFF07A" Offset="0.55"/>
            <GradientStop Color="#559B7BFF" Offset="0.8"/>
            <GradientStop Color="#55FF7AD0" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.OpacityMask>
          <RadialGradientBrush RadiusX="0.62" RadiusY="0.7">
            <GradientStop Color="#30000000" Offset="0"/>
            <GradientStop Color="#70000000" Offset="0.7"/>
            <GradientStop Color="#FF000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>
      <!-- Glossy highlight along the top -->
      <Ellipse Grid.RowSpan="2" IsHitTestVisible="False" Width="120" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,-6,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Collapsed header: icon | session · week | 2x2 status squares -->
      <Grid x:Name="Header" Margin="10,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- Simple orange spark icon -->
        <Canvas Width="26" Height="26" VerticalAlignment="Center">
          <Canvas.Resources>
            <Style TargetType="Rectangle">
              <Setter Property="Width" Value="4"/><Setter Property="Height" Value="22"/>
              <Setter Property="RadiusX" Value="2"/><Setter Property="RadiusY" Value="2"/>
              <Setter Property="Fill" Value="#D97757"/><Setter Property="Canvas.Left" Value="11"/><Setter Property="Canvas.Top" Value="2"/>
              <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            </Style>
          </Canvas.Resources>
          <Rectangle/>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="90"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="135"/></Rectangle.RenderTransform></Rectangle>
        </Canvas>
        <TextBlock x:Name="Summary" Text="…" Grid.Column="1" Foreground="#E5E5EA" FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <UniformGrid Grid.Column="2" Rows="2" Columns="2" VerticalAlignment="Center">
          <Border x:Name="SqSession" Style="{StaticResource Square}" Background="#4DFF9F0A" ToolTip="Session left">
            <Border x:Name="FillSession" Style="{StaticResource Fill}" Background="#FF9F0A"/>
          </Border>
          <Border x:Name="SqWeek" Style="{StaticResource Square}" Background="#4DBF5AF2" ToolTip="Week left">
            <Border x:Name="FillWeek" Style="{StaticResource Fill}" Background="#BF5AF2"/>
          </Border>
          <Border x:Name="SqExtra" Style="{StaticResource Square}" Background="#4DFF453A" ToolTip="Extra usage">
            <Border x:Name="FillExtra" Style="{StaticResource Fill}" Background="#FF453A" Height="0"/>
          </Border>
          <Border x:Name="SqStatus" Style="{StaticResource Square}" Background="#4D0A84FF" ToolTip="Connection">
            <Border x:Name="FillStatus" Style="{StaticResource Fill}" Background="#0A84FF" Height="0"/>
          </Border>
        </UniformGrid>
      </Grid>

      <!-- Vertical collapsed header, used when docked to the left/right edge -->
      <StackPanel x:Name="VHeader" Grid.RowSpan="2" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,10,0,0" Opacity="0">
        <Canvas Width="26" Height="26" HorizontalAlignment="Center">
          <Canvas.Resources>
            <Style TargetType="Rectangle">
              <Setter Property="Width" Value="4"/><Setter Property="Height" Value="22"/>
              <Setter Property="RadiusX" Value="2"/><Setter Property="RadiusY" Value="2"/>
              <Setter Property="Fill" Value="#D97757"/><Setter Property="Canvas.Left" Value="11"/><Setter Property="Canvas.Top" Value="2"/>
              <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            </Style>
          </Canvas.Resources>
          <Rectangle/>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="90"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="135"/></Rectangle.RenderTransform></Rectangle>
        </Canvas>
        <TextBlock x:Name="VSession" Text="…" Foreground="#E5E5EA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock x:Name="VWeek" Foreground="#E5E5EA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <!-- Same squares; fills mirror the horizontal header -->
        <UniformGrid Rows="2" Columns="2" HorizontalAlignment="Center" Margin="0,12,0,0">
          <Border Style="{StaticResource Square}" Background="#4DFF9F0A">
            <Border Style="{StaticResource Fill}" Background="#FF9F0A" Height="{Binding Height, ElementName=FillSession}"/>
          </Border>
          <Border Style="{StaticResource Square}" Background="#4DBF5AF2">
            <Border Style="{StaticResource Fill}" Background="#BF5AF2" Height="{Binding Height, ElementName=FillWeek}"/>
          </Border>
          <Border Style="{StaticResource Square}" Background="#4DFF453A">
            <Border Style="{StaticResource Fill}" Background="#FF453A" Height="{Binding Height, ElementName=FillExtra}"/>
          </Border>
          <Border Style="{StaticResource Square}" Background="#4D0A84FF">
            <Border Style="{StaticResource Fill}" Background="#0A84FF" Height="{Binding Height, ElementName=FillStatus}"/>
          </Border>
        </UniformGrid>
      </StackPanel>

      <!-- Expanded details: three columns on the top/bottom edge, stacked rows along the left/right edge -->
      <Grid x:Name="Details" Grid.Row="1" Margin="16,4,16,12" Opacity="0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="DSession" HorizontalAlignment="Center">
          <Grid Width="48" Height="48">
            <Path x:Name="SessionTrack" Stroke="#33FFFFFF" StrokeThickness="5"/>
            <Path x:Name="SessionArc" Stroke="#FF9F0A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock x:Name="SessionPct" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Session" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="SessionReset" Style="{StaticResource Small}"/>
        </StackPanel>
        <StackPanel x:Name="DWeek" Grid.Column="1" HorizontalAlignment="Center">
          <Grid Width="48" Height="48">
            <Path x:Name="WeekTrack" Stroke="#33FFFFFF" StrokeThickness="5"/>
            <Path x:Name="WeekArc" Stroke="#BF5AF2" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock x:Name="WeekPct" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Week" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="WeekReset" Style="{StaticResource Small}"/>
        </StackPanel>
        <StackPanel x:Name="DExtra" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="Extra usage" Foreground="#8E8E93" FontSize="10"/>
          <TextBlock x:Name="ExtraText" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,8"/>
          <TextBlock x:Name="StatusText" Text="Loading…" Foreground="#8E8E93" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
