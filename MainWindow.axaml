<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quota.MainWindow"
        Title="Claude Quota" Width="280" Height="36"
        Topmost="True" WindowDecorations="None" TransparencyLevelHint="Transparent"
        Background="Transparent" CanResize="False" ShowInTaskbar="False" ShowActivated="False">
  <!-- The window is exactly the size of the pill's envelope: the collapsed pill, or the expanded pill while
       hovered. It is placed in code against a screen edge; the pill animates its size inside it. -->
  <Window.Styles>
    <Style Selector="Border.sq">
      <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/>
      <Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="1.5"/>
    </Style>
    <Style Selector="Border.fill">
      <Setter Property="CornerRadius" Value="3"/><Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Height" Value="11"/>
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="Foreground" Value="#8E8E93"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Canvas.spark > Rectangle">
      <Setter Property="Width" Value="4"/><Setter Property="Height" Value="22"/>
      <Setter Property="RadiusX" Value="2"/><Setter Property="RadiusY" Value="2"/>
      <Setter Property="Fill" Value="#D97757"/><Setter Property="Canvas.Left" Value="11"/><Setter Property="Canvas.Top" Value="2"/>
    </Style>
    <Style Selector=":is(Control).fade">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/></Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <!-- Soap-bubble pill: nearly clear tint, swirling thin-film colours and an iridescent rim -->
  <Border x:Name="Pill" Width="280" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
          Background="#50000000" CornerRadius="0,0,16,16" BorderThickness="1.5,0,1.5,1.5" ClipToBounds="True">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%" TransformOrigin="50%,50%">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#B3FF8AD8" Offset="0.2"/>
        <GradientStop Color="#9970E6FF" Offset="0.45"/>
        <GradientStop Color="#99FFF27A" Offset="0.7"/>
        <GradientStop Color="#B3A98BFF" Offset="0.88"/>
        <GradientStop Color="#E6FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Refresh now" Click="Refresh_Click"/>
        <MenuItem x:Name="StartupItem" Header="Start at login" ToggleType="CheckBox" Click="Startup_Click"/>
        <Separator/>
        <MenuItem Header="Exit" Click="Exit_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="Inner" RowDefinitions="36,*">
      <Grid.Effect><DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.85" Color="Black"/></Grid.Effect>

      <!-- Thin-film colour swirl: strongest at the edge, nearly clear in the middle -->
      <Rectangle x:Name="Film" Grid.RowSpan="2" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%" TransformOrigin="50%,50%">
            <GradientStop Color="#55FF7AD0" Offset="0"/>
            <GradientStop Color="#4460DDFF" Offset="0.3"/>
            <GradientStop Color="#44FFF07A" Offset="0.55"/>
            <GradientStop Color="#559B7BFF" Offset="0.8"/>
            <GradientStop Color="#55FF7AD0" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.OpacityMask>
          <RadialGradientBrush RadiusX="62%" RadiusY="70%">
            <GradientStop Color="#30000000" Offset="0"/>
            <GradientStop Color="#70000000" Offset="0.7"/>
            <GradientStop Color="#FF000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>
      <!-- Glossy highlight along the top -->
      <Ellipse Grid.RowSpan="2" IsHitTestVisible="False" Width="120" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,-6,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Collapsed header: icon | session · week | 2x2 status squares -->
      <Grid x:Name="Header" Classes="fade" Margin="10,0,10,0" ColumnDefinitions="Auto,*,Auto">
        <!-- Simple orange spark icon -->
        <Canvas Classes="spark" Width="26" Height="26" VerticalAlignment="Center">
          <Rectangle/>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="90"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="135"/></Rectangle.RenderTransform></Rectangle>
        </Canvas>
        <TextBlock x:Name="Summary" Text="…" Grid.Column="1" Foreground="#E5E5EA" FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <UniformGrid Grid.Column="2" Rows="2" Columns="2" VerticalAlignment="Center">
          <Border x:Name="SqSession" Classes="sq" Background="#4DFF9F0A" ToolTip.Tip="Session left">
            <Border x:Name="FillSession" Classes="fill" Background="#FF9F0A"/>
          </Border>
          <Border x:Name="SqWeek" Classes="sq" Background="#4DBF5AF2" ToolTip.Tip="Week left">
            <Border x:Name="FillWeek" Classes="fill" Background="#BF5AF2"/>
          </Border>
          <Border x:Name="SqExtra" Classes="sq" Background="#4DFF453A" ToolTip.Tip="Extra usage">
            <Border x:Name="FillExtra" Classes="fill" Background="#FF453A" Height="0"/>
          </Border>
          <Border x:Name="SqStatus" Classes="sq" Background="#4D0A84FF" ToolTip.Tip="Connection">
            <Border x:Name="FillStatus" Classes="fill" Background="#0A84FF" Height="0"/>
          </Border>
        </UniformGrid>
      </Grid>

      <!-- Vertical collapsed header, used when docked to the left/right edge -->
      <StackPanel x:Name="VHeader" Classes="fade" Grid.RowSpan="2" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,10,0,0" Opacity="0">
        <Canvas Classes="spark" Width="26" Height="26" HorizontalAlignment="Center">
          <Rectangle/>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="90"/></Rectangle.RenderTransform></Rectangle>
          <Rectangle><Rectangle.RenderTransform><RotateTransform Angle="135"/></Rectangle.RenderTransform></Rectangle>
        </Canvas>
        <TextBlock x:Name="VSession" Text="…" Foreground="#E5E5EA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock x:Name="VWeek" Foreground="#E5E5EA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <!-- Same squares; fills mirror the horizontal header -->
        <UniformGrid Rows="2" Columns="2" HorizontalAlignment="Center" Margin="0,12,0,0">
          <Border Classes="sq" Background="#4DFF9F0A">
            <Border Classes="fill" Background="#FF9F0A" Height="{Binding #FillSession.Height}"/>
          </Border>
          <Border Classes="sq" Background="#4DBF5AF2">
            <Border Classes="fill" Background="#BF5AF2" Height="{Binding #FillWeek.Height}"/>
          </Border>
          <Border Classes="sq" Background="#4DFF453A">
            <Border Classes="fill" Background="#FF453A" Height="{Binding #FillExtra.Height}"/>
          </Border>
          <Border Classes="sq" Background="#4D0A84FF">
            <Border Classes="fill" Background="#0A84FF" Height="{Binding #FillStatus.Height}"/>
          </Border>
        </UniformGrid>
      </StackPanel>

      <!-- Expanded details: three columns on the top/bottom edge, stacked rows along the left/right edge -->
      <Grid x:Name="Details" Classes="fade" Grid.Row="1" Margin="16,4,16,12" Opacity="0" ColumnDefinitions="*,*,1.3*">
        <StackPanel x:Name="DSession" HorizontalAlignment="Center">
          <Grid Width="48" Height="48">
            <Path x:Name="SessionTrack" Stroke="#33FFFFFF" StrokeThickness="5"/>
            <Path x:Name="SessionArc" Stroke="#FF9F0A" StrokeThickness="5" StrokeLineCap="Round"/>
            <TextBlock x:Name="SessionPct" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Session" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="SessionReset" Classes="small"/>
        </StackPanel>
        <StackPanel x:Name="DWeek" Grid.Column="1" HorizontalAlignment="Center">
          <Grid Width="48" Height="48">
            <Path x:Name="WeekTrack" Stroke="#33FFFFFF" StrokeThickness="5"/>
            <Path x:Name="WeekArc" Stroke="#BF5AF2" StrokeThickness="5" StrokeLineCap="Round"/>
            <TextBlock x:Name="WeekPct" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Week" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="WeekReset" Classes="small"/>
        </StackPanel>
        <StackPanel x:Name="DExtra" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="Extra usage" Foreground="#8E8E93" FontSize="10"/>
          <TextBlock x:Name="ExtraText" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,8"/>
          <TextBlock x:Name="StatusText" Text="Loading…" Foreground="#8E8E93" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
