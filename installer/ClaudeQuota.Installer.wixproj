<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ClaudeQuota-Setup</OutputName>
    <OutputType>Package</OutputType>
    <!-- Version and published app folder are passed in by build-installer.ps1 -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PublishDir Condition="'$(PublishDir)' == ''">..\publish\</PublishDir>
    <SuppressIces>ICE91</SuppressIces>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
